# =============================================================================
# workflow/Snakefile
# Main entry point for the Snakelet pipeline.
#
# This version uses a checkpoint to dynamically discover samples after the
# BaseSpace download step, eliminating the need for a manual samples.tsv.
# =============================================================================

import os
from snakemake.io import glob_wildcards

# --- Load configuration -----------------------------------------------------
configfile: "config/config.yaml"

# --- Define output directory ------------------------------------------------
OUTDIR = config["outdir"]

# --- Include helper functions and rule modules ------------------------------
include: "rules/common.smk"
include: "rules/basespace.smk"
include: "rules/fastqc.smk"
include: "rules/fastp.smk"
include: "rules/spades.smk"
include: "rules/quast.smk"
include: "rules/busco.smk"
include: "rules/checkm.smk"
include: "rules/prokka.smk"
include: "rules/mlst.smk"
include: "rules/rgi.smk"
include: "rules/kraken2.smk"
include: "rules/bracken.smk"
include: "rules/abricate.smk"
include: "rules/mob_suite.smk"
include: "rules/eggnog.smk"
include: "rules/fastani.smk"

# --- Function to discover samples after the BaseSpace checkpoint ------------
def get_samples_from_download(wildcards):
    """
    Read the output directory of the basespace_download checkpoint
    and extract sample names from the FASTQ files found there.

    This function is evaluated *after* the checkpoint completes.
    """
    # Wait for the checkpoint to finish and get its output directory
    checkpoint_dir = checkpoints.basespace_download.get(**wildcards).output[0]

    # Glob for FASTQ files inside the checkpoint output directory.
    # Adjust the pattern if the downloaded structure differs.
    # Example structure: results/01_basespace/{sample}/*.fastq.gz
    fastq_files = glob_wildcards(os.path.join(checkpoint_dir, "{sample}_R1.fastq.gz")).sample

    # Return the unique list of sample names
    return list(set(fastq_files))


# --- Dynamic target rule ----------------------------------------------------
# The inputs of 'rule all' are determined at runtime, after the checkpoint.
rule all:
    input:
        # The checkpoint itself must be an input to trigger its execution
        # before the dynamic discovery happens.
        # (Alternatively, we can just let Snakemake discover it through the
        #  dependencies of the downstream rules, but making it explicit here
        #  clarifies the intent.)
        # Then, use the discovered samples to build the final target list.
        lambda wildcards: expand(
            f"{OUTDIR}/06_prokka/{{sample}}/{{sample}}.gff",
            sample=get_samples_from_download(wildcards)
        )
