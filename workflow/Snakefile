# workflow/Snakefile

import os
from snakemake.io import glob_wildcards

configfile: "config/config.yaml"

OUTDIR = config["outdir"]

include: "rules/common.smk"
include: "rules/fastp.smk"  # <-- Adicionado
# ... (outros includes: basespace, fastqc, spades, etc.)

# --- Lógica para a regra all ---
# Como ainda estamos começando sem o BaseSpace, vamos assumir que as amostras
# estão definidas em um samples.tsv (ou podemos ler do config).
# Por enquanto, vamos usar o samples.tsv para ter uma lista estática.
# Mais tarde, quando o BaseSpace for implementado, podemos mudar para checkpoint.

import pandas as pd
samples_df = pd.read_csv("config/samples.tsv", sep="\t")
SAMPLES = samples_df["sample"].tolist()

rule all:
    input:
        # Alvo padrão: executar o fastp para todas as amostras
        expand(f"{OUTDIR}/02_fastp/{{sample}}.html", sample=SAMPLES),
        expand(f"{OUTDIR}/02_fastp/{{sample}}.json", sample=SAMPLES)
        # Quando adicionarmos outras etapas, podemos mudar o alvo para o
        # resultado final (ex: Prokka), e o fastp será executado como dependência.
