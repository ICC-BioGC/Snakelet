# workflow/Snakefile

import pandas as pd

configfile: "config/config.yaml"

samples_df = pd.read_csv("config/samples.tsv", sep="\t")
SAMPLES = samples_df["sample"].tolist()

include: "rules/common.smk"
include: "rules/fastp.smk"
include: "rules/fastqc.smk"
include: "rules/multiqc.smk"
# ... (outros includes)

# --- Build final targets based on config ---
final_targets = []

qc_mode = config["qc"]["mode"]

# fastp
if qc_mode in ("full", "fastp"):
    final_targets.extend(expand(f"{get_step_dir('fastp')}/{{sample}}.html", sample=SAMPLES))
    final_targets.extend(expand(f"{get_step_dir('fastp')}/{{sample}}.json", sample=SAMPLES))
    final_targets.extend(expand(f"{get_step_dir('fastp')}/{{sample}}_R1.fastq.gz", sample=SAMPLES))

# FastQC
if qc_mode in ("full", "fastqc"):
    final_targets.extend(expand(f"{get_step_dir('fastqc')}/{{sample}}_fastqc.html", sample=SAMPLES))

# MultiQC (always, aggregates whatever ran)
final_targets.append(f"{get_step_dir('multiqc')}/multiqc_report.html")

# ... (adicionar alvos de assembly, etc., conforme forem implementados)

rule all:
    input:
        final_targets
